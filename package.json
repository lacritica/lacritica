{
  "name": "lacritica",
  "version": "1.0.0",
  "description": "La Crítica del Derecho: Hugo site with Pagefind search and Sveltia CMS",
  "repository": "lacritica/lacritica",
  "private": true,
  "scripts": {
    "start": "hugo server -s site -D",
    "build": "run-s build:hugo pagefind:index",
    "build:hugo": "hugo --minify -s site -d ../dist",
    "build:hugo:preview": "hugo -s site -d ../dist -D -F",
    "pagefind:index": "pagefind --site dist",
    "build:search": "run-s build"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "npm-run-all": "^4.1.5",
    "pagefind": "^1.4.0"
  }
}
